# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The site's public address, used in confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: emails (approval/rejection, ticket confirmation). Leave empty to skip sending.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Without one, Resend only delivers to your own account email.
EMAIL_FROM=Lineup <onboarding@resend.dev>
